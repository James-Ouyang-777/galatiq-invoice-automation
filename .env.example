# Copy to .env and fill in whichever providers you have.
# Resolution order: xAI (Grok) → OpenAI → Anthropic → Google.

XAI_API_KEY=
XAI_MODEL=grok-3

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Optional overrides
# DATABASE_PATH=inventory.db
# INVOICES_DIR=data/invoices
# HIGH_VALUE_THRESHOLD=10000
# MATH_TOLERANCE=1.0
# HOST=127.0.0.1
# PORT=8000
